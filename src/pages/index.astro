---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { SITIO, PRODUCTOS, urlAbsoluta, url } from '../lib/sitio.ts';
import CajaRegalo from '../components/CajaRegalo.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const temas = (PRODUCTOS || []).filter((p) => p.tema);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITIO.nombre,
  url: urlAbsoluta('/'),
  description: SITIO.descripcion,
  inLanguage: SITIO.idioma,
};
---
<Layout title={`${SITIO.nombre} — ${SITIO.tagline}`} description={SITIO.descripcion} tipo="website" schema={schema}>
  <!-- 1) Portada: queremos ayudar -->
  <section class="hero">
    <div class="contenedor">
      <span class="pill">{SITIO.hero_badge}</span>
      <h1>{SITIO.tagline}</h1>
      <p class="sub">{SITIO.descripcion}</p>
      <p class="hero-ayuda">Estamos para ayudarte a lograrlo: guías claras, gratis y al grano — sin vueltas ni humo.</p>
      <a href="#regalo" class="btn btn-acento">Quiero mi regalo gratis 🎁</a>
    </div>
  </section>

  <!-- 2) Temario: qué vas a encontrar -->
  <section id="temario" class="contenedor mt-2">
    <h2>Qué vas a encontrar acá</h2>
    <p class="muted">Todo explicado simple y sin costo. Estos son los temas que tratamos:</p>
    <div class="temario mt-2">
      {temas.map((p) => (
        <a class="temario-item" href={url(`/blog?cat=${p.id}`)}>
          <span class="temario-tema">{p.tema}</span>
          <span class="temario-desc">Guías y consejos, explicados simple y paso a paso.</span>
        </a>
      ))}
      <a class="temario-item temario-todos" href={url('/blog')}>
        <span class="temario-tema">Todas las guías →</span>
        <span class="temario-desc">Explorá todos los artículos del blog.</span>
      </a>
    </div>
  </section>

  <!-- 3) Últimas guías -->
  {posts.length > 0 && (
    <section class="contenedor-ancho mt-2">
      <h2>Últimas guías del blog</h2>
      <div class="grid grid-3 mt-2">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  <!-- 5) Regalos (abajo del todo): por correo o WhatsApp -->
  <section id="regalo" class="contenedor mt-2">
    <h2>Llevate tu regalo gratis 🎁</h2>
    <p class="muted">Elegí el que te sirva. Te lo mandamos por correo o, si preferís, directo a tu WhatsApp.</p>
    <div class="regalos-lista mt-2">
      {PRODUCTOS.map((p) => <CajaRegalo producto={p} />)}
    </div>
  </section>
</Layout>
